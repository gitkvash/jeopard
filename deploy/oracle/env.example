# Copy to /opt/jeopard/.env on the VM (chmod 600). Never committed.

# The hostname the game is served on. With no domain, an sslip.io name that
# resolves to the VM's own address works and Let's Encrypt issues for it:
#   158.180.18.180  ->  158-180-18-180.sslip.io
# A DuckDNS name (like linkup's) is the alternative if sslip.io is rate limited.
JEOPARD_HOST=158-180-18-180.sslip.io

# Generate it, do not think one up:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=jeopard
POSTGRES_USER=jeopard

# Games one address may create per hour (0 disables).
JEOPARD_GAMES_PER_HOUR=30
LOG_LEVEL=INFO

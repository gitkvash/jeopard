# Copy to /opt/jeopard/.env on the VM (chmod 600). Never committed.

# The hostname the game is served on: a DuckDNS name pointed at the VM, like
# linkup's. Changing it is this line plus a redeploy; Caddy fetches the new
# certificate and the backend's allowed origins follow it.
# With no DuckDNS name, an sslip.io one works too: 158-180-18-180.sslip.io
JEOPARD_HOST=jeopard-kvasho.duckdns.org

# Generate it, do not think one up:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=jeopard
POSTGRES_USER=jeopard

# Games one address may create per hour (0 disables).
JEOPARD_GAMES_PER_HOUR=30
LOG_LEVEL=INFO

# Copy to .env on the server and fill in. .env is gitignored; .env.example is not.

# The hostname the game is served on. Either a domain you own, or -- with no
# domain registered -- an sslip.io name that resolves to this box's own address:
#
#   JEOPARD_HOST=203-0-113-45.sslip.io      (for the IP 203.0.113.45)
#
# Let's Encrypt issues certificates for sslip.io names, so HTTPS is real either
# way, and swapping in a domain later is this one line.
#
# Set it to ":80" to serve plain HTTP with no certificate -- correct on a LAN,
# where there is no public name to certify.
JEOPARD_HOST=203-0-113-45.sslip.io

# Postgres. Generate the password, do not think one up:
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=jeopard
POSTGRES_USER=jeopard

# Games one address may create per hour. Creating a game needs no credentials by
# design, so this is what stops a public URL being used to fill the database.
# 0 disables the limit.
JEOPARD_GAMES_PER_HOUR=30

# INFO for a deployment; DEBUG traces every state change of every game.
LOG_LEVEL=INFO

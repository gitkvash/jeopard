# Jeopard's site block for the Caddy that linkup runs on the same VM.
#
# deploy.sh replaces __HOST__ and installs the result as
# /opt/edge/conf.d/jeopard.caddy, which linkup's Caddyfile imports. It is the same
# routing as deploy/Caddyfile: one origin for the Flutter build, the REST API and
# the WebSocket, because a page served over https cannot open a plain ws:// socket
# and a split deployment would lose the buzzer while REST kept working.
__HOST__ {
	encode zstd gzip

	handle /api/* {
		reverse_proxy jeopard-backend:8080
	}
	handle /ws* {
		reverse_proxy jeopard-backend:8080
	}
	handle /actuator/health {
		reverse_proxy jeopard-backend:8080
	}

	# Asked for once per browser by flutter_bootstrap.js. Until 2026-10-14 the
	# client's files went out as immutable for a year, and a browser holding
	# them -- an icon font without today's icons, say -- never asks again.
	handle /clear-cache {
		header Cache-Control "no-store"
		header Clear-Site-Data "\"cache\""
		respond 204
	}

	handle {
		# Bind-mounted from /opt/jeopard/web by linkup's compose file.
		root * /srv/jeopard-web

		# Flutter names nothing by content hash -- main.dart.js, fonts and the
		# asset manifest keep their names across builds -- so all of it must
		# revalidate. Only the icons are safe to cache hard.
		@revalidate path / /index.html /flutter_bootstrap.js /flutter_service_worker.js /version.json /manifest.json /main.dart.js /assets/* /canvaskit/*
		header @revalidate Cache-Control "no-cache, must-revalidate"

		@immutable path /icons/* /favicon.png
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
